{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/*)",
      "Bash(pnpm *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(rg *)"
    ],
    "deny": ["Bash(git push *)", "Bash(git reset --hard *)"]
  }
}
